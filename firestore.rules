
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function admin() {
      return request.auth != null
        && request.auth.uid == 'tadNQeNTUQMGd5UTqT9HdnlTnfk2'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function validRegistration() {
      let d = request.resource.data;

      return d.keys().hasOnly([
        'team', 'leader', 'contact', 'rush',
        'rush2', 'grenadier', 'support',
        'logo', 'status', 'createdAt'
      ])
      && d.keys().hasAll([
        'team', 'leader', 'contact', 'rush',
        'rush2', 'grenadier', 'support',
        'logo', 'status', 'createdAt'
      ])
      && d.team is string
      && d.team.size() > 0
      && d.team.size() <= 50
      && d.leader is string
      && d.leader.size() > 0
      && d.leader.size() <= 50
      && d.contact is string
      && d.contact.size() >= 8
      && d.contact.size() <= 25
      && d.rush is string
      && d.rush.size() > 0
      && d.rush.size() <= 40
      && d.rush2 is string
      && d.rush2.size() > 0
      && d.rush2.size() <= 40
      && d.grenadier is string
      && d.grenadier.size() > 0
      && d.grenadier.size() <= 40
      && d.support is string
      && d.support.size() > 0
      && d.support.size() <= 40
      && d.logo is string
      && d.logo.size() <= 80000
      && (
        d.logo == '' ||
        d.logo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
      )
      && d.status == 'pending'
      && d.createdAt == request.time;
    }

    match /admins/{uid} {
      allow get: if request.auth != null
        && request.auth.uid == uid;

      allow list, create, update, delete: if false;
    }

    match /registrations/{id} {
      allow create: if validRegistration();

      allow get, list: if admin();

      allow update: if admin()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status'])
        && request.resource.data.status in [
          'pending', 'approved', 'reserve', 'rejected'
        ];

      allow delete: if admin();
    }

    match /publicTeams/{id} {
      allow get, list: if true;

      allow create, update: if admin()
        && request.resource.data.keys().hasAll([
          'team', 'logo', 'status',
          'placement', 'kills', 'points'
        ])
        && request.resource.data.keys().hasOnly([
          'team', 'logo', 'status',
          'placement', 'kills', 'points'
        ])
        && request.resource.data.team is string
        && request.resource.data.team.size() <= 50
        && request.resource.data.logo is string
        && request.resource.data.logo.size() <= 80000
        && request.resource.data.status in [
          'approved', 'reserve'
        ]
        && request.resource.data.placement is int
        && request.resource.data.placement >= 0
        && request.resource.data.placement <= 10000
        && request.resource.data.kills is int
        && request.resource.data.kills >= 0
        && request.resource.data.kills <= 10000
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= 10000;

      allow delete: if admin();
    }

    match /settings/xt {
      allow get: if true;
      allow list: if false;

      allow create, update: if admin()
        && request.resource.data.keys().hasAll([
          'event', 'capacity', 'rules'
        ])
        && request.resource.data.keys().hasOnly([
          'event', 'capacity', 'rules'
        ])
        && request.resource.data.event is string
        && request.resource.data.event.size() > 0
        && request.resource.data.event.size() <= 100
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 1
        && request.resource.data.capacity <= 100
        && request.resource.data.rules is string
        && request.resource.data.rules.size() > 0
        && request.resource.data.rules.size() <= 3000;

      allow delete: if false;
    }

    match /history/{id} {
      allow get, list: if true;

      allow create: if admin()
        && request.resource.data.keys().hasAll([
          'event', 'finishedAt', 'teamsCount',
          'registrationsCount', 'ranking'
        ])
        && request.resource.data.keys().hasOnly([
          'event', 'finishedAt', 'teamsCount',
          'registrationsCount', 'ranking'
        ])
        && request.resource.data.event is string
        && request.resource.data.finishedAt == request.time
        && request.resource.data.teamsCount is int
        && request.resource.data.registrationsCount is int
        && request.resource.data.ranking is list;

      allow update, delete: if false;
    }

    match /partners/{id} {
      allow get, list: if true;

      allow create, update: if admin()
        && request.resource.data.keys().hasAll([
          'name', 'description', 'url', 'logo'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'url', 'logo'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && request.resource.data.logo is string
        && request.resource.data.logo.size() <= 80000;

      allow delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
